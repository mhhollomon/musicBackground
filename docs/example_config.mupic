# Please see docs/mupic-concepts.md
# for deeper discussions of some points.

# ---------------------------------
# COLORS
# ---------------------------------
# You can use the following formats for colors:
#    HTML hex code #RRGGBB
#    Common HTML named colors
#    RGB function "rgb(r,g,b)" or percentages "rgb(r%,g%,b%)"
#    HSL function "hsl(h,s,l)" or percentages "hsl(h,s%,l%)" 
#    HSV function "hsv(h,s,v)" or percentages "hsv(h,s%,v%)"
#
# Hex codes and named colors do not need to be quoted. The others do.


# ---------------------------------
# Paths
# ---------------------------------
# Any path (e.g. for include or images) is resolved as follows :
# - If the path is absolute, it is used as is.
# - If it starts with './' then it is resolved relative to the current directory.
# - Otherwise, it is resolved realtive to the directory containing the
#      the configuration file currently being read.
# Examples :
#    assume that '/a/b/file.mupic' is the current file
#    assume that '/c/d' is the current working directory
#  '/e/f/moo.pg'   ==> (rule 1) /e/f/moo.png
#  './e/f/moo.png' ==> (rule 2) /c/d/e/f/moo.png
#   'e/f/moo.pnh   => (rule 3) /a/b/e/f/moo.png
#  '../e/f/moo.png' ==> (rule 3) /a/e/f/moo.png
#

#---------------------------------
# Include file
#---------------------------------

# Include another file in this one. The values from the included
# file will be added to the current configuration FIRST, so that
# they can be overridden by the values in this file.
# Only one file may be included. However, nesting can go to 20 levels.
# The file path must be double-quoted.
# The path will be resolved as in the `Paths` section above.
# Any include statement must be the first statement in the file.

include "/path/to/file.mupic"

#---------------------------------
# Settings
#---------------------------------

# Set the default zorder. The default
# is that elements later in the file are on top of earliers (asc).
# This allows you reverse that by using `desc`

set zorder asc

#---------------------------------
# Defaults
#---------------------------------

# Font - This is the font that will be used for all text items
# unless it is overridden in the configuration for that item.
# The default value will vary according to the platform.
# Quotes are needed for the value if there are spaces, tabs, commas or
# quotes in the value.

default font  "My Cool Font"

# Fill - The default color of any text item unless it is
# overridden in the configuration for that item.
# The default is white.
# Any color format from above may be used.
# Quotes are needed for the value if there are spaces, tabs, commas or
# quotes in the value.


default fill white

#---------------------------------
# Output Configuration
#---------------------------------
# This is the "main" section of the output and is the only
# section of the configuration that is required.
# This sets the size and format of the final image as well
# as the file to write to.
# Everything else is written on top of this layer.

output {
    # Only PNG, JPG (or JPEG), and WEBP outputs are currently supported.
    # The extension on the filename will be used to determine the format.
    # This can be overriden on the command line with the `-o` or `--output_path`
    # parameter.
    # This path is resolved using the rules in the `Paths` section above.

    path = "/path/to/output/file.png"

    # This is the size of the output image in WIDTHxHEIGHT format.
    # Required.
    size = 1980x1080

    # This is the base color of the output image. It will be the
    # color of any area that isn't otherwise covered by the various elements.
    # 'black' is the default.
    # optional
    color = "rgb(0,0,0)"

    # Size of the margin. Default is 0.
    # optional.
    margin = 10

    # An image to use as a part of the background. See fit.
    # optional

    background = "/some/file.png"

    # How to place the background image on the output.
    # For `cover`, the image is resized to completely cover the 
    # output. The `color` parameter is not used. In this case,
    # the image is what will be seen in the transparent margin as
    # well as in the content area of the output.
    # If fit is `contain`, the image is resized to the content area
    # of the output.
    # See the concepts document about bounding boxes.
    # Note that in both cases, the image is stretched as needed. aspect
    # ratio is not preserved.
    # optional. default = contain

    fit = cover # or contain

    # Define a border.
    # This will be between the margin and content areas.
    # optional. Default = no border.
    #
    # A shorter border spec is also available.
    # border = color, width

    border {
        # Define the width of each side of the border.
        # If you wnat them to be the same you can just give that
        # number :
        #   width = 5
        # is the same as :
        #   width { l=5 r=5 t=5 b=5 }
        # If sides are left out of the spec (or set to zero),
        # no border will be drawn on that side.
        # required.

        width { l=10 r=5 t=10 b=4 }

        # Color to paint the border. Any of the above color formats may be used.
        # required.

        color = "hsv(20, 50%, 90%)"
    }
}

#---------------------------------
# Text Configuration
#---------------------------------

# Arbitrary text blocks can be added.
# While a name is not required, a name is needed if this element is
# to be used as target of an attach or if you need to override settings
# given in an included file.
# Names must be unique across all elements. also the names `border`, 
# and `output` may not be used.
# Names with special characters or spaces must be quoted.

# Text and Image elements are rendered in the order they appear in the file 
# (but after the output section, regardless of order).
# Elements in an included file will be rendered before any elements in the
# including file. Elements with the same name will be merged into a single
# configuration with the including file's settings taking precedence. However,
# the element will be rendered in the order set by the included file.
#

# See mupic-concepts.md for information about z-order.
# optional defaults to 0.
#

text "name"  -20 {
    # The actual text. Multiple lines can be given using "\n" to denote the end of the line.
    # required.
    text = "This is the title"

    # Size of the text in pixels (not points)
    # This is the size of the font that will be used.
    size = 200

    # Position for the text on the output.
    # See mupic-concepts.md for details
    # required.
    position = "output(40%, 40%)"

    # Font to use for the text.
    # defaults to the `default` font setting if not given (see above).
    # optional.
    font = 'DejaVuSans.ttf'

    # Fill color for the text
    # see above for color formats.
    # Uses the `default` fill if that has been given, otherwise white.
    # optional. 
    fill = "hsv(0,0%,100%)"

    # Control the stroke.
    # See above for color formats.
    # Width is a single integer.
    # optional.
    stroke {
        # Color of the ink for the stroke.
        # required.
        color = "hsv(0,0%,100%)"

        # Width of the stroke in pixels.
        # required.
        width = 2
    }

    # Control Rotation
    # For text, the only values allowed are :
    # -90 - text reads bottom to top
    #   0 - text reads left to right
    #  90 - text reads top to bottom
    # 180 - text reads right to left (and upside down)
    # Optional. Defaults to 0
    rotation = 0

    # Border
    # Same as for output
    # optional. Defaults to no border.
    border {
        color = "rgb(0,0,0)"
        width = 5
    }

}

#---------------------------------
# Image Configuration
#---------------------------------

# Arbitrary image elements can be added.
# While a name is not required, a name is needed if this element is
# to be used as target of an attach or if you need to override settings
# given in an included file.
# Names must be unique across all elements. also the names `border`, 
# and `output` may not be used.
# Names with special characters or spaces must be quoted.

# See the `text` element section for discussion of rendering order.

# Since the actual image is optional, the image element can also be used
# to draw colored rectangles on the output.

image some_name {

    # Sets the content of the new element.
    # If it is not specified, the content area will be filed with
    # the background color of specified. Otherwise, it will be transparent.
    # Optional
    content {
        # One of `file` or `color` must be given.
        # If both are given, it is an error.

        # The path to the image.
        # The image can be any type supported by the `pillow` module.
        # This path is resolved using the rules in the `Paths` section above.
        # optional.
        file = /path/to/cover/file.png

        # Color to use as the content
        # optional.
        color = #112233

        # fit
        # How to place the image in the element. This is ignored for `color`.
        # stretch
        #   The image is force resized to the content bbox. Aspect Ratio is not preserved.
        # contain, <align>
        #   The image is resized to completely fit into the bbox maintaining aspect ratio.
        #   If the scaled image is smaller than the bbox, align (`min`, `mid`, `max`)
        #   is used to decide how to place the image in the bbox.
        # fill, <crop>
        #   The image is resized to completely fill the bbox maintaining aspect ratio.
        #   If the scaled image is larger than the bbox, crop (`min`, `mid`, `max`)
        #   is used to decide which part of the image to save.
        # See the tests/image_fit.mupic for examples.
        fit = fill, mid

        # Algorithm to compute a mask for the logo image. This is ignored for `color`.
        # "self" - uses the luminance channel of the image as-is. This means that
        #     the background will show through at least a little on any part of
        #     the logo image that is not fully white.
        # "black" - clamps the luminance channel, so that only black pixels in the logo 
        #     are transparent.
        # "alpha" - uses the alpha channel of the image as a mask.
        # "auto" - automatically chooses between "alpha" and "black". This is the default.
        # "none" : No masking is done.
        # optional
        mask = auto
    }

    # background color.
    # This is the color that will fill the margin and content if not otherwise specified.
    # optional. Default is `black`
    color = green

    # position
    # See mupic-concepts.md for details
    # required.
    position = "attach(some_ele, mid, mid)"


    # Size for the image.
    # An absolute size can be specified using a WxH format :
    #   size = 400x600
    # The size can also be specified as relative to the positioning
    # target elements content bbox (see the concepts document).
    #   size = max  # element will be the same size as the target element
    #   size = maxsquare # The element will be the size of the largest square
    #                    # that will fit in the target element.
    #   size = scale, <factor> # The element will be the size of the the target
    #                          # element scaled by <factor> in both dimensions.
    # required.
    size = scale, 0.8

    # border for the image.
    # See the `output` border section for details.
    # optional. Defaults to no border.
    border = green, 20

    # margin
    # Size of the margin in pixels.
    # optional. Defaults to no margin.
    margin = 10

}

