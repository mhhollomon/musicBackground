# ./mupic tests/boxes.mupic

# Random Text blocks show some of the new functionality.

default fill black

output {
    path = ../test-out/boxes.png
    size = 1920x1080
    color = white
    border {
        width = 10
        color = darkblue
    }
}

image "thin_box" {
    size = 900x5
    color = red
    position = "overlay(output.content, 50%, 10%, mid, mid)"
}

text "news" {
    text = "MuPic"
    size = 100
    fill = white
    color = red
    gap = 20
    position = "overlay(output.content, 50%, 10%, mid, mid)"
}

text "one" {
    text = "• Unicode support"
    size = 50
    position = "overlay(output.content, 10%, 15% )"
}

text "two" {
    text = "• Border for full image"
    size = 50
    position = "attach(one, bottom, min, min, 15)"
}

text "three" {
    text = "• Borders for embedded images"
    size = 50
    position = "attach(two, bottom, min, min, 15)"
}

text "t4" {
    text = "• Color background for text"
    size = 50
    color = "#88dd88"
    gap = 8
    position = "attach(three, bottom, -8px, min, 15)"
}

text "t5" {
    text = "• Border for text"
    size = 50
    gap = 8
    border  {
        width = 5
        color = "#88dd88"
    }
    position = "attach(t4, bottom, -5, min, 15)"
}

text "t6" {
    text = "• Images can just be a color (see line in header)"
    size = 50
    position = "attach(t5, bottom, +13px, min, 15)"
}

text "t7" {
    text = "• Negative relative positioning"
    size = 50
    position = "attach(t6, bottom, 0, min, 15)"
}

text "t8" {
    text = "• Used to align decorated text above"
    font = "/mnt/c/Windows/fonts/arialbi.ttf"
    size = 30
    position = "attach(t7, bottom, 50px, min, 15)"
}

text "t9" {
    text = "• Pixel and percentage relative positioning"
    size = 50
    position = "attach(t8, bottom, -50px, min, 30)"
}


image "bordered" {
    content {
        file = resources/portrait-mode.png
    }
    size = 300x300
    border {
        width = 11
        color = darkblue
    }
    position = "overlay(output, max, max, 20)"
}

text "borderhost" {
    text = "Add elements to borders"
    gap = 5
    border {
        width = 60
        color = yellow
    }
    size = 70
    position = "overlay(output, min, max, 20)"
}

text "topborder" {
    text = "♥ Top border"
    size = 30
    position = "overlay(borderhost.border.top, mid, mid)"
}

text "bottomborder" {
    text = "♥ Bottom border"
    size = 30
    position = "overlay(borderhost.border.bottom, mid, mid)"
}

text "leftborder" {
    text = "♥ left"
    size = 30
    rotation = 90
    position = "overlay(borderhost.border.left, mid, mid)"
}

text "rightborder" {
    text = "♥ right"
    size = 30
    rotation = -90
    position = "overlay(borderhost.border.right, mid, mid)"
}
