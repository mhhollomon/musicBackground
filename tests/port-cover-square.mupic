# ./mupic ./tests/port-cover-square.mupic

# landscape cover to square on portrait output with margin and border.

output {
  size = 1080x1920
  path = ../test-out/port-cover-square.png
}

image cover {
    size = maxsquare
    position = "output(min, min)"
    content {
        file = "resources/landscape-mode.png"
        fit = fill, mid
    }
    margin = 10
    border = blue, 100
}
