
output {
    size = 600x800
    path = ../test-out/transform.png
    color = white
    border = black, 2
}

image norotate {
    size = 100x100
    position = "output(210, 100)"
    border = green, 5
    color = blue
    transform = scale, 3, 1
}

image rotate {
    size = 100x100
    position = "output(210, 400)"
    border = green, 5
    color = blue
    transform = scale, 3, 1
    rotation = 90
}
