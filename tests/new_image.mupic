
output {
    path = ../test-out/new_image.png
    size = 1000x1300
    color = hsv(120,35%,64%)
    border = black, 2
}

image file_content {
    size = 500x500
    position = "output(100, 100)"
    content {
        file = resources/portrait-mode.png
        fit = fill, mid
        mask = black
    }
    margin = 20
    border = red, 5
    color = hsv(180,77%,64%)
}

image color_content {
    size = 500x500
    position = "output(100, 700)"
    content {
        color = hsv(60,35%,64%)
    }
    margin = 20
    border = red, 5
    color = hsv(180,77%,64%)
}
