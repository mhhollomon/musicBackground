output {
    size = 1920x1080
    color = white
    path = ../test-out/templates.png
    border = black, 2
}

image starter {
    size = 600x600
    color = blue
    position = "output(min, mid, 20)"
}

template t(i, o) {{{ 
    image b$i {
        size = scale, 0.7
        position = "attach($P, right, mid, mid, $o)"
        color = "hsv($i0, 50%, 80%)"
    }
}}}

render t(1, 10)
render t(2, 25)
render t(3, 40)
render t(4, 55)

#----------------------------------

image logo 1000 {
    size = 75x75
    position = "overlay(output, max, max, max, max, 10)"
    content {
        file = ../../muArt/src/common/viking-treble-clef-no-fill.png
        mask = auto
    }

}

text title 1000 {
    size = 30
    font = /mnt/c/Windows/fonts/ariali.ttf
    text = "Mind The Gap"
    position = "overlay(output, mid, max, mid, max, 10)"
    fill = black
}
