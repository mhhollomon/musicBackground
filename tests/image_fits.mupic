# ./mupic tests/image_fits.mupic

output {
    size = 1000x1000
    color = white
    path = ../test-out/image_fits.png
    border = black, 2
}

image stretch_la {
    size=200x200
    position = "overlay(output, 200, 100)"
    content {
        file = resources/landscape-mode.png
        fit = stretch
    }
    color = blue
    border = black, 2
}


image contain_min_la {
    size=200x200
    position = "overlay(output, 200, 350)"
    content {
        file = resources/landscape-mode.png
        fit = contain, min
    }
    border = black, 2
}


image contain_mid_la {
    size=200x200
    position = "attach(contain_min_la, right, min, min, 50)"
    content {
        file = resources/landscape-mode.png
        fit = contain, mid
    }
    border = black, 2
}

image contain_max_la {
    size=200x200
    position = "attach(contain_mid_la, right, min, min, 50)"
    content {
        file = resources/landscape-mode.png
        fit = contain, max
    }
    border = black, 2
}

#-------------- 

image fill_min_la {
    size=200x200
    position = "overlay(output, 200, 600)"
    content {
        file = resources/landscape-mode.png
        fit = fill, min
    }
    border = black, 2
}

image fill_mid_la {
    size = 200x200
    position = "attach(fill_min_la, right, min, min, 50)"
    content {
        file = resources/landscape-mode.png
        fit = fill, mid
    }
    border = black, 2
}

image fill_max_la {
    size = 200x200
    position = "attach(fill_mid_la, right, min, min, 50)"
    content {
        file = resources/landscape-mode.png
        fit = fill, max
    }
    border = black, 2
}

# ------------------------------
text stretch_la_txt {
    text = "stretch"
    fill = black
    size = 40
    position = "attach(stretch_la, left, mid, mid, 20)"
}

text contain_la_txt {
    text = "contain"
    fill = black
    size = 40
    position = "attach(contain_min_la, left, mid, mid, 20)"
}
text fill_la_txt {
    text = "fill"
    fill = black
    size = 40
    position = "attach(fill_min_la, left, mid, mid, 20)"
}
